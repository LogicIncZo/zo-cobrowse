            "type": "array",
            "title": "Request Variants"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/PublicMediaPriceRange"
            },
            "type": "array",
            "title": "Prices"
          },
          "price_rules": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PublicMediaFixedPriceRule"
                },
                {
                  "$ref": "#/components/schemas/PublicMediaBoundedLinearPriceRule"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "bounded_linear": "#/components/schemas/PublicMediaBoundedLinearPriceRule",
                  "fixed_request": "#/components/schemas/PublicMediaFixedPriceRule"
                }
              }
            },
            "type": "array",
            "title": "Price Rules"
          },
          "output": {
            "$ref": "#/components/schemas/PublicMediaOutputCapability"
          }
        },
