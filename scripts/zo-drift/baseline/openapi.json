              "image.inpaint",
              "video.generate",
              "video.edit",
              "video.extend",
              "speech.generate",
              "audio.transcribe"
            ],
            "title": "Operation"
          },
          "availability": {
            "type": "string",
            "const": "public",
            "title": "Availability"
          },
          "product_role": {
            "type": "string",
            "title": "Product Role"
          },
          "request_variants": {
            "items": {
              "$ref": "#/components/schemas/PublicMediaRequestCapability"
