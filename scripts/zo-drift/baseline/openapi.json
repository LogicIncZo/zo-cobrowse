      "PublicMediaBoundedLinearPriceRule": {
        "properties": {
          "selector": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "type": "object",
            "title": "Selector"
          },
          "included_in_free_allowance": {
            "type": "boolean",
            "title": "Included In Free Allowance"
          },
          "kind": {
            "type": "string",
            "const": "bounded_linear",
            "title": "Kind"
          },
          "basis": {
            "type": "string",
            "enum": [
              "characters",
              "duration_milliseconds"
            ],
            "title": "Basis"
          },
          "units_per_step": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Units Per Step"
          },
          "charge_usd_per_step": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2,6}$",
            "title": "Charge Usd Per Step"
          },
          "minimum_steps": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Minimum Steps"
          },
          "maximum_steps": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Maximum Steps"
          }
