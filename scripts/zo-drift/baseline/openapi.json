        "type": "object",
        "required": [
          "selector",
          "included_in_free_allowance",
          "kind",
          "basis",
          "units_per_step",
          "charge_usd_per_step",
          "minimum_steps",
          "maximum_steps"
        ],
        "title": "PublicMediaBoundedLinearPriceRule",
        "description": "One bounded linear retail price safe to render in product surfaces."
      },
      "PublicMediaFixedPriceRule": {
