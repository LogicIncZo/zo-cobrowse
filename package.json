{
  "name": "zo-cobrowse",
  "version": "0.2.5",
  "description": "Co-browsing extension powered by Zo — AI backend that sees your page and takes actions through it.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test tests/",
    "test:watch": "bun test tests/ --watch",
    "test:coverage": "bun test tests/ --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test -c e2e/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test -c e2e/playwright.config.ts --debug",
    "check-icons": "bash scripts/check-release.sh",
    "check-prereqs": "bash scripts/check-release.sh",
    "lint": "bash scripts/check-release.sh",
    "verify": "bash scripts/verify.sh",
    "check:drift": "bun scripts/zo-drift/check.ts",
    "evals": "bun scripts/prompt-evals/run.ts",
    "evals:live": "bun --env-file=.env scripts/prompt-evals/run.ts --live",
    "setup-hooks": "bash scripts/install-hooks.sh",
    "capture:prompts": "bun --env-file=.env tests/test-prompts/capture.ts",
    "package": "cd extension && zip -r ../zo-cobrowse.zip . -x '*.git*' -x '*.DS_Store'"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "acorn": "^8.14.0",
    "bun-types": "latest",
    "happy-dom": "^20.11.2",
    "zod": "^4.4.3"
  }
}